<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RedEyeLab - Email OSINT Tool | BlackCatHacks</title>
<style>
body{background:#0a0a0a;color:#00ff41;font-family:monospace;padding:20px;}
.container{max-width:700px;margin:0 auto;border:1px solid #00ff41;padding:25px;box-shadow:0 0 15px #00ff4180;border-radius:8px;}
h1{text-align:center;color:#fff;} h1 span{color:#ff0000;}
.subtitle{text-align:center;color:#888;margin-bottom:20px;}
input{width:93%;padding:12px;background:#111;border:1px solid #00ff41;color:#fff;font-size:16px;border-radius:4px;}
button{padding:12px 20px;background:#00ff41;color:#000;border:none;font-weight:bold;cursor:pointer;margin-top:15px;width:100%;font-size:16px;border-radius:4px;}
button:hover{background:#fff;}
.result{margin-top:25px;background:#111;padding:15px;border-left:3px solid #ff0000;display:none;border-radius:4px;}
a{color:#00bfff;text-decoration:none;}
a:hover{text-decoration:underline;}
</style>
</head>
<body>
<div class="container">
<h1>👁️ <span>RedEyeLab</span> Email OSINT</h1>
<p class="subtitle">Powered by BlackCatHacks - For Educational Purpose Only</p>

<input type="email" id="email" placeholder="Enter target email address...">
<button onclick="investigate()">INVESTIGATE</button>

<div id="result" class="result"></div>
</div>

<script>
async function investigate(){
  let email = document.getElementById('email').value.trim();
  if(!email){alert("Please enter an email address!");return;}

  document.getElementById('result').style.display='block';
  document.getElementById('result').innerHTML = `
    <h3>Investigation Results for: ${email}</h3>
    <p>✅ <b>Gravatar Profile Check:</b><br><a href="https://en.gravatar.com/site/check/${email}" target="_blank">View Gravatar Result</a></p>
    <p>✅ <b>Epieos - Google Account Check:</b><br><a href="https://epieos.com/?q=${email}" target="_blank">Investigate on Epieos: ${email}</a></p>
    <p>✅ <b>Breach Check (Have I Been Pwned):</b><br><a href="https://haveibeenpwned.com/account/${email}" target="_blank">Check if email is breached</a></p>
    <p>✅ <b>Google Dork Search:</b><br><a href="https://www.google.com/search?q=%22${email}%22" target="_blank">Search "${email}" on Google</a></p>
    <p>✅ <b>Holehe Check:</b><br><a href="https://github.com/megadose/holehe" target="_blank">Use Holehe tool for 120+ sites check</a></p>
    <hr>
    <p style="color:#888;font-size:12px;">Disclaimer: This tool only creates public OSINT links. Made by RedEyeLab.</p>
  `;
}
</script>
</body>
</html>
